# Copy to docker/.env (or let `bash docker/dev.sh up` generate one automatically).
PRESTASHOP_IMAGE=prestashop/prestashop:9.1.5-8.5
SHOP_PORT=8088
SHOP_DOMAIN=localhost:8088
PS_LANGUAGE=cs
PS_COUNTRY=cz
PS_DEV_MODE=1
PS_FOLDER_ADMIN=admin-dev
ADMIN_MAIL=admin@example.test
ADMIN_PASSWORD=change-me-local-admin-password
DB_NAME=prestashop
DB_PASSWORD=change-me-local-db-password

# Default Pays credentials prefilled on first module setup in the dev shop:
PAYS_MERCHANT=dev-merchant
PAYS_SHOP=dev-shop
PAYS_PASSWORD=dev-api-password
